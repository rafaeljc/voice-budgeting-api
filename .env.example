# Copie para .env (não versionado) e ajuste os valores:
#   cp .env.example .env
# O Docker Compose lê o .env sozinho; para o bootRun, carregue-o no shell:
#   set -a && source .env && set +a

# Credenciais do MySQL local (compose.yml). Valores de exemplo, sem valor fora da sua máquina.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=app
MYSQL_PASSWORD=change-me

# Chave da API da OpenAI, necessária só para executar a aplicação (os testes não usam)
OPENAI_API_KEY=sk-your-key-here
