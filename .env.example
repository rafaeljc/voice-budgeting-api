# Copie para .env (não versionado) e ajuste os valores:
#   cp .env.example .env
# O Docker Compose lê o .env sozinho; para o bootRun, carregue-o no shell:
#   set -a && source .env && set +a

# Credenciais do MySQL local (compose.yml). Valores de exemplo, sem valor fora da sua máquina.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=app
MYSQL_PASSWORD=change-me

# Credenciais do MongoDB de auditoria local (compose.yml). Valores de exemplo, sem valor fora da sua máquina.
MONGO_USERNAME=audit
MONGO_PASSWORD=change-me

# Chave da API da OpenAI, necessária só para executar a aplicação (os testes não usam)
OPENAI_API_KEY=sk-your-key-here

# Alternativa: Azure OpenAI no lugar da OpenAI. Para usar, coloque a chave do recurso Azure em OPENAI_API_KEY e
# descomente as variáveis abaixo, trocando <recurso> pelo nome do recurso Azure OpenAI.
#
# Deployments necessários (com estes nomes):
#   - gpt-4.1-mini
#   - gpt-4o-mini-tts
#   - whisper-1
#
# Por que duas URLs base:
#   - chat e voz usam a rota v1, então a base termina em /openai/v1
#   - a transcrição só responde pela rota por deployment, então usa o host puro e o modo microsoft-foundry
#
# Atenção: o deployment do Whisper costuma ter limite baixo (ex.: 3 requisições por minuto).
# SPRING_AI_OPENAI_BASE_URL=https://<recurso>.openai.azure.com/openai/v1
# SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-4.1-mini
# SPRING_AI_OPENAI_AUDIO_TRANSCRIPTION_MICROSOFT_FOUNDRY=true
# SPRING_AI_OPENAI_AUDIO_TRANSCRIPTION_BASE_URL=https://<recurso>.openai.azure.com
# SPRING_AI_OPENAI_AUDIO_TRANSCRIPTION_MICROSOFT_DEPLOYMENT_NAME=whisper-1

# Segredo (mínimo de 32 bytes) que assina e valida os tokens JWT HS256; só para desenvolvimento
JWT_SECRET=change-me-dev-secret-at-least-32-bytes
